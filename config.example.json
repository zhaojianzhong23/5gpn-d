{
  "listen": {
    "dot": ":853",
    "tls": ":443",
    "http": ":80"
  },
  "cert_file": "/etc/letsencrypt/live/dot.example.com/fullchain.pem",
  "key_file": "/etc/letsencrypt/live/dot.example.com/privkey.pem",
  "gateway_ip": "203.0.113.10",
  "client_cidr": [
    "172.22.0.0/16"
  ],
  "upstream_dns": [
    "223.5.5.5:53",
    "119.29.29.29:53"
  ],
  "socks5": "127.0.0.1:1080",
  "rules_file": "/etc/dotmux/rules.conf",
  "cache_size": 8192,
  "synthetic_ttl": 60,
  "log": {
    "level": "info"
  },
  "rules": {
    "refresh_hours": 24,
    "cache_dir": "/var/lib/dotmux/rules",
    "remote": [
      {
        "name": "gfw",
        "url": "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/gfw.txt",
        "format": "domain",
        "prefix": "DOMAIN-SUFFIX",
        "action": "proxy"
      }
    ]
  },
  "telegram": {
    "token": "123456:replace-me",
    "admin_ids": [
      123456789
    ],
    "state_file": "/var/lib/dotmux/tg-state.json",
    "profile_url": "https://dot.example.com/ios-dot.mobileconfig"
  },
  "quic": {
    "enabled": true,
    "listen": ":443",
    "idle_sec": 30
  }
}
