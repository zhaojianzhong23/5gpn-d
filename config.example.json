{
  "listen": { "dot": ":853", "tls": ":443", "http": ":80" },
  "domain": "dot.example.com",
  "cert_file": "/etc/letsencrypt/live/dot.example.com/fullchain.pem",
  "key_file": "/etc/letsencrypt/live/dot.example.com/privkey.pem",
  "gateway_ip": "203.0.113.10",
  "client_cidr": ["172.22.0.0/16"],
  "remote_dns": ["1.1.1.1", "8.8.8.8", "9.9.9.9"],
  "local_dns": ["101.226.4.6", "218.30.118.6", "180.76.76.76", "119.29.29.29"],
  "exits": [
    { "name": "local", "type": "direct", "addr": "" },
    { "name": "香港", "type": "socks5", "addr": "user:pass@1.2.3.4:1080" }
  ],
  "default_exit": "香港",
  "routing_enabled": true,
  "rules_file": "/etc/dotmux/rules.conf",
  "cache_size": 8192,
  "synthetic_ttl": 60,
  "log": { "level": "info" },
  "rules": {
    "refresh_hours": 24,
    "cache_dir": "/var/lib/dotmux/rules",
    "remote": [
      {
        "name": "gfw",
        "url": "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/gfw.txt",
        "format": "domain",
        "prefix": "DOMAIN-SUFFIX",
        "action": "proxy"
      }
    ]
  },
  "telegram": {
    "token": "",
    "admin_ids": [],
    "state_file": "/var/lib/dotmux/tg-state.json",
    "profile_url": ""
  },
  "quic": { "enabled": true, "listen": ":443", "idle_sec": 30 }
}
